{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/bulk-preflight.py\"",
            "timeout": 15,
            "statusMessage": "preflight"
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/branch-check.py\"",
            "timeout": 15,
            "statusMessage": "branch"
          }
        ]
      }
    ]
  }
}
